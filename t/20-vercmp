#!/usr/bin/env bash
# Version comparison: the primitive every check depends on.
set -uo pipefail
. "$(dirname "$0")/lib.sh"
. "$(cd "$(dirname "$0")/.." && pwd)/vivo-setup-internal/lib/common.sh"

# cmp A B WANT -- want is one of ==, >, <
cmp_is() {
    local rc=0 got
    vs_vercmp "$1" "$2" || rc=$?
    case "$rc" in
        0) got="==" ;;
        1) got=">"  ;;
        2) got="<"  ;;
        *) got="?"  ;;
    esac
    t_is "$1 $3 $2" "$got" "$3"
}

cmp_is 3.10.0   3.9.0    ">"    # string comparison gets this backwards
cmp_is 3.9.0    3.10.0   "<"
cmp_is 3.10     3.10.0   "=="   # missing fields are zero
cmp_is 1        1.0.0    "=="
cmp_is 0.5.1    0.10     "<"
cmp_is 3.2.57   3.2.57   "=="
cmp_is 0.9.7    0.5.0    ">"
cmp_is 1.2.0rc1 1.2.0    "=="   # a field's non-numeric suffix is dropped
cmp_is 08.1     8.1      "=="   # base ten, not bad octal
cmp_is 0.64.22  0.64.25  "<"

t_rc "vs_vercmp_lt true when older"  0 vs_vercmp_lt 1.0 2.0
t_rc "vs_vercmp_lt false when newer" 1 vs_vercmp_lt 2.0 1.0
t_rc "vs_vercmp_lt false when equal" 1 vs_vercmp_lt 2.0 2.0

t_summary
