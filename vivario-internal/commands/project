#!/usr/bin/env bash
# description: whether this directory is inside an initialized vivario project
set -euo pipefail
. "$(dirname "$0")/../lib/common.sh"

NAME=project
# The same rule vivo itself uses: a project root is a directory containing
# .vivario/project.toml, found by walking up from the working directory.
MARKER=.vivario/project.toml

usage() {
    printf 'Usage: vivario-setup project [OPTIONS]\n\n'
    printf '  Reports whether the working directory sits inside an initialized\n'
    printf '  vivario project, by walking up for %s -- the same\n' "$MARKER"
    printf '  rule vivo uses. Detection only: this does not create a project yet.\n\n'
    vs_flag_help
}

about() {
    vs_about <<'TXT'
A vivario project is any directory containing .vivario/project.toml. vivo
finds it by walking up from wherever you are, and refuses to run at all
outside one -- so this has to be true before vivo is of any use.

Each project has its own root and its own configuration. The
prerequisites above are installed once per machine and shared; a project
is per directory tree, and you can have as many as you like.
TXT
}

# --- detect ---------------------------------------------------------------

root=""
has_dir=""
has_marker=""
proj_name=""
proj_created=""

# Read one key from the [project] table. Enough TOML for this: the value is a
# quoted string, and the table ends at the next [header].
project_key() {
    awk -v key="$1" '
        /^\[project\]/ { inside = 1; next }
        /^\[/          { inside = 0 }
        inside && $0 ~ "^" key " *=" {
            split($0, parts, "\"")
            print parts[2]
            exit
        }
    ' "$root/$MARKER"
}

detect() {
    local dir
    dir=$(pwd)
    while [ -n "$dir" ] && [ "$dir" != "/" ]; do
        if [ -f "$dir/$MARKER" ]; then
            root=$dir
            has_dir=yes
            has_marker=yes
            vs_debug "project root: $root"
            break
        fi
        if [ -d "$dir/.vivario" ] && [ -z "$has_dir" ]; then
            # A .vivario/ with no project.toml looks like a project to a person
            # but not to vivo, so it is worth reporting distinctly.
            root=$dir
            has_dir=yes
            vs_debug ".vivario/ without $MARKER at $dir"
        fi
        dir=$(dirname "$dir")
    done
    if [ -n "$has_marker" ]; then
        proj_name=$(project_key name)
        proj_created=$(project_key created)
        vs_debug "project name: ${proj_name:-unknown}"
    fi
}

# --- report ---------------------------------------------------------------

state=""
fix=""

report() {
    if [ -z "$has_dir" ]; then
        vs_info ".vivario/" "$VS_NOT_OK" "$VS_ACT_NEEDS_YOU" "nothing found above $(vs_tilde "$(pwd)")"
        vs_info "  project.toml" "$VS_NOT_OK" "$VS_ACT_NEEDS_YOU" "vivo will not run outside a project"
        state=$VS_NOT_OK
        fix="vivario-setup does not create projects yet; run this inside one"
        return 0
    fi

    vs_info ".vivario/" "$VS_OK" "$VS_ACT_NONE" "$(vs_tilde "$root")"

    if [ -z "$has_marker" ]; then
        vs_info "  project.toml" "$VS_NOT_OK" "$VS_ACT_NEEDS_YOU" "the directory names no project"
        state=$VS_NOT_OK
        fix="a .vivario/ without project.toml is not a project vivo accepts"
        return 0
    fi

    vs_info "  project.toml" "$VS_OK" "$VS_ACT_NONE" \
        "${proj_name:-unnamed}${proj_created:+, created $proj_created}"
    state=$VS_OK
}

# --- run ------------------------------------------------------------------

vs_parse_args ${@+"$@"} || exit 2
if [ "$VS_ACTION" = help ]; then
    usage
    exit 0
fi
if [ "$VS_ACTION" = notes ]; then
    VS_NOTES=1
    vs_note_name "$NAME"
    about
    exit 0
fi

detect
report

if [ "$state" = "$VS_OK" ]; then
    about
    exit 0
fi
vs_note "$fix"
about
exit "$VS_RC_BLOCKED"
