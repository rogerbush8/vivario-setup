#!/usr/bin/env bash
# description: install or upgrade whatever is missing, after confirming
set -euo pipefail
. "$(dirname "$0")/../lib/common.sh"

usage() {
    printf 'Usage: vivario-setup install [OPTIONS]\n\n'
    printf '  Reports what it would do, asks, then does it. Safe to re-run: what\n'
    printf '  is already in place is left alone.\n\n'
    vs_flag_help
}

vs_parse_args ${@+"$@"} || exit 2
if [ "$VS_ACTION" = help ]; then
    usage
    exit 0
fi

HERE=$(cd "$(dirname "$0")" && pwd)
INTERNAL=$(dirname "$HERE")

# Plan first, always. analyze reports its finding through its exit status, so
# there is no second pass over the leaves here -- which would have re-run every
# detection and every network lookup just to recount what was already counted.
rc=0
VS_SUPPRESS_NEXT_STEP=1 "$HERE/analyze" \
    ${VS_VERBOSE:+--verbose} ${VS_DEBUG:+--debug} ${VS_OFFLINE:+--offline} || rc=$?

case "$rc" in
    "$VS_RC_WORK"|"$VS_RC_UPGRADE")
        ;;
    0)
        # analyze has already said everything is ready and how to start.
        exit 0
        ;;
    "$VS_RC_BLOCKED")
        printf '\n  Nothing I can install -- the items above need you.\n'
        exit 1
        ;;
esac

# vs_confirm emits its own leading blank line.
if ! vs_confirm "proceed?"; then
    printf '  Nothing done.\n'
    exit 1
fi

vs_heading "installing"
failed=0
leaves=$(mktemp)
trap 'rm -f "$leaves"' EXIT
vs_ordered_prerequisites "$INTERNAL" > "$leaves"
while IFS= read -r leaf; do
    # Already confirmed once, for the whole plan.
    VS_ASSUME_YES=1 "$leaf" --install ${VS_DEBUG:+--debug} ${VS_OFFLINE:+--offline} \
        || failed=1
done < "$leaves"
exit "$failed"
