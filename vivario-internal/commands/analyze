#!/usr/bin/env bash
# description: report what is on this system and what would be done
set -euo pipefail
. "$(dirname "$0")/../lib/common.sh"

usage() {
    printf 'Usage: vivario-setup analyze [OPTIONS]\n\n'
    printf '  Reports this machine, every prerequisite, and this project, then\n'
    printf '  summarises what to do next. Changes nothing.\n\n'
    vs_flag_help
}

vs_parse_args ${@+"$@"} || exit 2
if [ "$VS_ACTION" = help ]; then
    usage
    exit 0
fi

printf '\nVIVARIO INSTALL PLAN'

HERE=$(cd "$(dirname "$0")" && pwd)
INTERNAL=$(dirname "$HERE")
FLAGS="${VS_VERBOSE:+--verbose} ${VS_DEBUG:+--debug} ${VS_OFFLINE:+--offline}"

# --- system ---------------------------------------------------------------
#
# The OS is a gate, not a prerequisite. Nothing below can be fixed while it
# fails, so there is no point reporting any of it.
vs_heading "system"
sys_rc=0
"$HERE/system" ${FLAGS} || sys_rc=$?

if [ "$sys_rc" = "$VS_RC_BLOCKED" ]; then
    vs_heading "summary"
    vs_info "System:" "$VS_NOT_OK" "needs you" "the OS must be updated first"
    printf '\n  Nothing else was checked -- update macOS, then run this again.\n'
    exit "$VS_RC_BLOCKED"
fi

# system reports the network state through its exit status, so nothing probes
# twice: 0 usable, 2 asked to stay offline, 3 unreachable.
if [ "$sys_rc" -ne 0 ]; then
    export VS_OFFLINE=1
    FLAGS="$FLAGS --offline"
fi

# --- prerequisites --------------------------------------------------------

vs_heading "prerequisites"

# Redirected from a file rather than piped: a `while read` on the end of a pipe
# runs in a subshell, so every count set inside it would be discarded -- which
# silently made this command always report success.
leaves=$(mktemp)
prenotes=$(mktemp)
trap 'rm -f "$leaves" "$prenotes"' EXIT
export VS_PRENOTE_FILE="$prenotes"
vs_ordered_prerequisites "$INTERNAL" > "$leaves"

installs=0
upgrades=0
blocked=0
while IFS= read -r leaf; do
    rc=0
    # Flags must be forwarded explicitly: each leaf is its own process and
    # inherits nothing it was not handed.
    "$leaf" --install --dry-run ${FLAGS} || rc=$?
    case "$rc" in
        "$VS_RC_WORK")    installs=$((installs + 1)) ;;
        "$VS_RC_UPGRADE") upgrades=$((upgrades + 1)) ;;
        "$VS_RC_BLOCKED") blocked=$((blocked + 1)) ;;
    esac
done < "$leaves"
work=$((installs + upgrades))

# --- vivo -----------------------------------------------------------------

vs_heading "vivo"
vivo_rc=0
"$HERE/vivo" ${FLAGS} || vivo_rc=$?
case "$vivo_rc" in
    "$VS_RC_WORK")    installs=$((installs + 1)); work=$((work + 1)) ;;
    "$VS_RC_UPGRADE") upgrades=$((upgrades + 1)); work=$((work + 1)) ;;
    "$VS_RC_BLOCKED") blocked=$((blocked + 1)) ;;
esac

# --- project --------------------------------------------------------------

vs_heading "project"
project_rc=0
"$HERE/project" ${FLAGS} || project_rc=$?

# --- notes ----------------------------------------------------------------
#
# Collected at the end rather than interleaved, so the rows above stay tables
# that can be read at a glance. Notes are static prose, so this costs no extra
# detection.
if [ -n "${VS_VERBOSE:-}" ]; then
    vs_heading "notes"
    "$HERE/system" --notes || true
    while IFS= read -r leaf; do
        "$leaf" --notes || true
    done < "$leaves"
    "$HERE/vivo" --notes || true
    "$HERE/project" --notes || true
fi

# --- summary --------------------------------------------------------------

vs_heading "summary"

plural() {
    if [ "$1" -eq 1 ]; then
        printf '1 %s\n' "$2"
    else
        printf '%s %ss\n' "$1" "$2"
    fi
}

if [ "$work" -eq 0 ] && [ "$blocked" -eq 0 ]; then
    vs_info "Prerequisites:" "$VS_OK" "$VS_ACT_NONE" "already installed"
elif [ "$work" -gt 0 ]; then
    if [ "$upgrades" -eq 0 ]; then
        act=$(plural "$installs" install)
    elif [ "$installs" -eq 0 ]; then
        act=$(plural "$upgrades" upgrade)
    else
        act=$(plural "$work" action)
        detail="$(plural "$installs" install), $(plural "$upgrades" upgrade)"
    fi
    vs_info "Prerequisites:" "$VS_NOT_OK" "$act" "${detail:-}"
    if [ "$blocked" -gt 0 ]; then
        vs_info "" "$VS_NOT_OK" "needs you" "$(plural "$blocked" item)"
    fi
else
    vs_info "Prerequisites:" "$VS_NOT_OK" "needs you" "$(plural "$blocked" item)"
fi

if [ "$vivo_rc" -eq 0 ]; then
    vs_info "Vivo:" "$VS_OK" "$VS_ACT_NONE" "already installed"
else
    vs_info "Vivo:" "$VS_NOT_OK" "$VS_ACT_NEEDS_INSTALL" "not installed"
fi

if [ "$project_rc" -eq 0 ]; then
    vs_info "Project:" "$VS_OK" "$VS_ACT_NONE" "already initialized"
else
    vs_info "Project:" "$VS_NOT_OK" "needs you" "no project here"
fi

if [ -s "$prenotes" ]; then
    vs_heading "pre-install notes"
    sed 's/^./  &/' "$prenotes"
fi

# What to do next.
#
# install sets VS_SUPPRESS_NEXT_STEP because telling the reader to run install
# immediately before install prompts them would be absurd. It suppresses the
# SUGGESTION only -- when there is nothing to do no prompt is coming, so the
# ready line always prints. Suppressing that too is what made bare
# `vivario-setup` -- the main entry point -- end on "Nothing to do." and never
# say the one thing the reader wants.
if [ "$work" -gt 0 ]; then
    if [ -z "${VS_SUPPRESS_NEXT_STEP:-}" ]; then
        printf '\n  To install what is missing:  %% ./vivario-setup install\n'
    fi
    exit "$VS_RC_WORK"
fi

if [ "$blocked" -gt 0 ] || [ "$project_rc" -ne 0 ]; then
    if [ -z "${VS_SUPPRESS_NEXT_STEP:-}" ]; then
        printf '\n  Resolve the items above, then run this again.\n'
    fi
    exit "$VS_RC_BLOCKED"
fi

printf '\n  **Vivario is ready to run!**  To start:  %% ./vivario-start\n'
