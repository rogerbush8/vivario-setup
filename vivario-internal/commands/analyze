#!/usr/bin/env bash
# description: report what is on this system and what would be done
set -euo pipefail
. "$(dirname "$0")/../lib/common.sh"

usage() {
    printf 'Usage: vivario-setup analyze [OPTIONS]\n\n'
    printf '  Reports this machine, every prerequisite, and this project, then\n'
    printf '  summarises what to do next. Changes nothing.\n\n'
    vs_flag_help
}

vs_parse_args ${@+"$@"} || exit 2
if [ "$VS_ACTION" = help ]; then
    usage
    exit 0
fi

printf '\nINSTALL PLAN\n'

HERE=$(cd "$(dirname "$0")" && pwd)
INTERNAL=$(dirname "$HERE")
PAYLOAD=$(dirname "$INTERNAL")
FLAGS="${VS_VERBOSE:+--verbose} ${VS_DEBUG:+--debug} ${VS_OFFLINE:+--offline}"

# --- system ---------------------------------------------------------------
#
# The OS is a gate, not a prerequisite. Nothing below can be fixed while it
# fails, so there is no point reporting any of it.
vs_heading "system"
sys_rc=0
"$HERE/system" ${FLAGS} || sys_rc=$?

if [ "$sys_rc" = "$VS_RC_BLOCKED" ]; then
    vs_heading "summary"
    printf '  %-16s%-9s%s\n' "System:" "blocked" "the OS must be updated first"
    printf '\n  Nothing else was checked -- update macOS, then run this again.\n'
    exit "$VS_RC_BLOCKED"
fi

# system reports the network state through its exit status, so nothing probes
# twice: 0 usable, 2 asked to stay offline, 3 unreachable.
if [ "$sys_rc" -ne 0 ]; then
    export VS_OFFLINE=1
    FLAGS="$FLAGS --offline"
fi

# --- prerequisites --------------------------------------------------------

vs_heading "prerequisites"

# Redirected from a file rather than piped: a `while read` on the end of a pipe
# runs in a subshell, so every count set inside it would be discarded -- which
# silently made this command always report success.
leaves=$(mktemp)
trap 'rm -f "$leaves"' EXIT
vs_ordered_prerequisites "$INTERNAL" > "$leaves"

work=0
blocked=0
while IFS= read -r leaf; do
    rc=0
    # Flags must be forwarded explicitly: each leaf is its own process and
    # inherits nothing it was not handed.
    "$leaf" --install --dry-run ${FLAGS} || rc=$?
    case "$rc" in
        "$VS_RC_WORK")    work=$((work + 1)) ;;
        "$VS_RC_BLOCKED") blocked=$((blocked + 1)) ;;
    esac
done < "$leaves"

# --- project --------------------------------------------------------------

vs_heading "project"
project_rc=0
"$HERE/project" ${FLAGS} || project_rc=$?

# --- notes ----------------------------------------------------------------
#
# Collected at the end rather than interleaved, so the rows above stay tables
# that can be read at a glance. Notes are static prose, so this costs no extra
# detection.
if [ -n "${VS_VERBOSE:-}" ]; then
    vs_heading "notes"
    "$HERE/system" --notes || true
    while IFS= read -r leaf; do
        "$leaf" --notes || true
    done < "$leaves"
    "$HERE/project" --notes || true
fi

# --- summary --------------------------------------------------------------

vs_heading "summary"

# vs_summary LABEL STATE DETAIL -- one scope per line, so they read as a set.
vs_summary() {
    printf '  %-16s%-9s%s\n' "$1:" "$2" "$3"
}

if [ "$work" -eq 0 ] && [ "$blocked" -eq 0 ]; then
    vs_summary "Prerequisites" "$VS_OK" "no action, already installed"
elif [ "$work" -gt 0 ]; then
    if [ "$work" -eq 1 ]; then
        detail="1 to install or upgrade"
    else
        detail="$work to install or upgrade"
    fi
    if [ "$blocked" -gt 0 ]; then
        detail="$detail, $blocked needing you"
    fi
    vs_summary "Prerequisites" "action" "$detail"
elif [ "$blocked" -eq 1 ]; then
    vs_summary "Prerequisites" "blocked" "1 needs you to act"
else
    vs_summary "Prerequisites" "blocked" "$blocked need you to act"
fi

if [ "$project_rc" -eq 0 ]; then
    vs_summary "Project" "$VS_OK" "no action, already initialized"
else
    vs_summary "Project" "blocked" "no initialized project here"
fi

if [ -n "${VS_SUPPRESS_NEXT_STEP:-}" ]; then
    # install is about to prompt; telling the user to run install would be odd.
    if [ "$work" -gt 0 ]; then
        exit "$VS_RC_WORK"
    fi
    if [ "$blocked" -gt 0 ] || [ "$project_rc" -ne 0 ]; then
        exit "$VS_RC_BLOCKED"
    fi
    exit 0
fi

printf '\n'
if [ "$work" -gt 0 ]; then
    printf '  To install what is missing:  %% ./vivario-setup install\n'
elif [ "$blocked" -gt 0 ] || [ "$project_rc" -ne 0 ]; then
    printf '  Resolve the items above, then run this again.\n'
elif [ -x "$PAYLOAD/vivario-start" ]; then
    printf '  To start vivario:  %% ./vivario-start\n'
else
    # Do not point at something that is not there.
    printf '  Everything is ready. vivario-start is not in this payload yet.\n'
fi

if [ "$work" -gt 0 ]; then
    exit "$VS_RC_WORK"
fi
if [ "$blocked" -gt 0 ] || [ "$project_rc" -ne 0 ]; then
    exit "$VS_RC_BLOCKED"
fi
