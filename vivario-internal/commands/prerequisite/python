#!/usr/bin/env bash
# description: a uv-managed CPython for vivo to run on
set -euo pipefail
. "$(dirname "$0")/../../lib/common.sh"

NAME=python
# The floor vivario needs: every vivario pyproject.toml declares
# requires-python = ">=3.10".
PYTHON_MIN=3.10
# What gets installed. Pinned exactly rather than to a series, because the point
# of using a uv-managed interpreter is that every machine runs the same one --
# tracking "3.12" would let machines drift apart by patch. Bump deliberately.
PYTHON_VERSION=3.12.12

usage() {
    printf 'Usage: vivario-setup prerequisite python [OPTIONS]\n\n'
    printf '  Checks for a uv-MANAGED CPython of at least %s, and installs\n' "$PYTHON_MIN"
    printf '  %s if there is none.\n\n' "$PYTHON_VERSION"
    printf '  Interpreters from Homebrew, pyenv or the system are deliberately\n'
    printf '  ignored: vivo runs on its own, so it cannot be broken by an upgrade\n'
    printf '  or a rehash somewhere else, and nothing here touches yours.\n\n'
    vs_flag_help
}

about() {
    vs_about <<'TXT'
vivo runs on its own Python, downloaded and managed by uv, kept under
uv's own directory and used for nothing else.

That is deliberate. A Python from Homebrew or pyenv can be upgraded,
re-shimmed or removed by something unrelated to vivario, and vivo would
break through no fault of its own. Pinning an interpreter vivario
controls removes that whole class of problem -- and it means nothing here
has any opinion about the Python your projects use.
TXT
}

# --- detect ---------------------------------------------------------------
#
# Only uv-managed interpreters count. A managed one is any whose path sits under
# `uv python dir`, which is how uv itself distinguishes them.

found=""
version=""
managed_dir=""

detect() {
    if ! have_cmd uv; then
        vs_debug "no uv yet; it is installed before this runs"
        return 0
    fi
    managed_dir=$(uv python dir 2>/dev/null || true)
    if [ -z "$managed_dir" ]; then
        vs_debug "uv reported no managed-python directory"
        return 0
    fi
    vs_debug "managed dir: $managed_dir"
    # Highest managed version at or above the floor.
    local line ver
    while IFS= read -r line; do
        case "$line" in
            *"$managed_dir"*) ;;
            *) continue ;;
        esac
        ver=$(printf '%s\n' "$line" | awk -F- '{print $2}')
        if vs_vercmp_lt "$ver" "$PYTHON_MIN"; then
            vs_debug "ignoring managed $ver, below $PYTHON_MIN"
            continue
        fi
        if [ -z "$version" ] || ! vs_vercmp_lt "$ver" "$version"; then
            version=$ver
            found=yes
        fi
    done <<EOF
$(uv python list --only-installed 2>/dev/null || true)
EOF
    if [ -n "$found" ]; then
        vs_debug "managed python: $version"
    else
        vs_debug "no managed python at or above $PYTHON_MIN"
    fi
}

# --- plan -----------------------------------------------------------------

state=""
action=""
detail=""
fix=""

plan() {
    fix="uv python install $PYTHON_VERSION"
    if [ -z "$found" ]; then
        state=$VS_NOT_OK
        action=$VS_ACT_NEEDS_INSTALL
        detail="no uv-managed interpreter"
        return 0
    fi
    state=$VS_OK
    action=$VS_ACT_NONE
    detail="uv-managed$([ -n "$managed_dir" ] && printf ' (%s)' "$(vs_tilde "$managed_dir")")"
}

# --- run ------------------------------------------------------------------

vs_parse_args ${@+"$@"} || exit 2
if [ "$VS_ACTION" = help ]; then
    usage
    exit 0
fi
if [ "$VS_ACTION" = notes ]; then
    VS_NOTES=1
    vs_note_name "$NAME"
    about
    exit 0
fi

detect
plan

vs_report "$NAME" "$version" "$state" "$action" "$detail"

if [ "$state" = "$VS_OK" ]; then
    about
    exit 0
fi

vs_note "$fix"
# Situational: only worth saying when an interpreter is actually about to appear.
vs_prenote "python" <<TXT
a uv-managed CPython $PYTHON_VERSION will be installed, used by vivario and
nothing else. It is isolated and will not interfere with any Python on your
system or in your projects.
TXT
about

if [ "$VS_ACTION" != install ] || [ -n "$VS_DRY_RUN" ]; then
    exit "$VS_RC_WORK"
fi

if ! vs_confirm "run: $fix"; then
    vs_report "$NAME" "$version" "$VS_NOT_OK" "$VS_ACT_NEEDS_YOU" "not confirmed"
    exit "$VS_RC_BLOCKED"
fi

vs_debug "running: $fix"
eval "$fix"
detect
plan
action=$VS_ACT_INSTALLED
vs_report "$NAME" "$version" "$state" "$action" "$detail"
[ "$state" = "$VS_OK" ]
