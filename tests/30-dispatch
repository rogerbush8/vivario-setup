#!/usr/bin/env bash
# The dispatcher: argv walking, help at every level, flag forwarding.
set -uo pipefail
. "$(dirname "$0")/lib.sh"

ROOT=$(cd "$(dirname "$0")/.." && pwd)
VS="$ROOT/vivario-setup"

t_rc "--version"                      0 /bin/bash "$VS" --version
t_is "--version prints VERSION" \
     "$(/bin/bash "$VS" --version)" "$(cat "$ROOT/vivario-internal/VERSION")"

t_rc "--help (top)"                   0 /bin/bash "$VS" --help
t_rc "--help (group)"                 0 /bin/bash "$VS" prerequisite --help
t_rc "--help (leaf)"                  0 /bin/bash "$VS" prerequisite uv --help

t_rc "unknown command exits 2"        2 /bin/bash "$VS" nosuchthing
t_rc "unknown subcommand exits 2"     2 /bin/bash "$VS" prerequisite nosuchthing
t_rc "unknown flag exits 2"           2 /bin/bash "$VS" prerequisite uv --nosuchflag

# Whether this host is fully set up. Several assertions below can only be made
# when it is, and a host that legitimately needs something installed must not be
# reported as a test failure.
host_clean=yes
/bin/bash "$VS" analyze --offline >/dev/null 2>&1 || host_clean=""

# Help is derived from each command's own header, not a registry.
top=$(/bin/bash "$VS" --help)
t_contains "top help lists analyze"      "$top" "analyze"
t_contains "top help lists prerequisite" "$top" "prerequisite"
grp=$(/bin/bash "$VS" prerequisite --help)
t_contains "group help lists uv"   "$grp" "uv"
t_contains "group help lists cmux" "$grp" "cmux"

# A group forwards its flags to every child, so all children must accept them.
# Asserted on behaviour rather than wording: --offline reaching the leaf means no
# fetch is attempted, which --debug reports. Matching prose here would make this
# test fail every time the report is reworded.
fwd=$(/bin/bash "$VS" prerequisite --offline --debug 2>&1 || true)
t_contains "group forwards --offline to a leaf" "$fwd" "offline: skipping"
t_contains "group reached uv"                   "$fwd" "uv"
t_contains "group reached cmux"                 "$fwd" "cmux"
case "$fwd" in
    *"fetching"*) t_bad "--offline did not suppress the fetch" ;;
    *)            t_ok  "--offline suppressed every fetch" ;;
esac

# A leaf documents its own flags -- the dispatcher must not intercept --help.
leaf=$(/bin/bash "$VS" prerequisite uv --help)
t_contains "leaf help shows its flags" "$leaf" "--dry-run"

# --verbose and --debug answer different questions and must stay separable.
verbose_only=$(/bin/bash "$VS" prerequisite uv --verbose --offline 2>&1)
debug_only=$(/bin/bash "$VS" prerequisite uv --debug --offline 2>&1)

# Keyed on the SHAPE of an explanatory block -- vs_about indents six spaces --
# rather than on any sentence inside it. Matching prose fails on every rewording
# while catching no defect.
has_prose() {
    printf '%s\n' "$1" | command grep -qE '^      [A-Za-z]'
}

if has_prose "$verbose_only"; then
    t_ok  "--verbose emits an explanatory block"
else
    t_bad "--verbose emitted no explanatory block"
fi
case "$verbose_only" in
    *"[debug]"*) t_bad "--verbose leaked diagnostics" ;;
    *)           t_ok  "--verbose carries no diagnostics" ;;
esac

t_contains "--debug shows what was run"  "$debug_only" "[debug]"
if has_prose "$debug_only"; then
    t_bad "--debug leaked the explanation"
else
    t_ok  "--debug carries no explanation"
fi

# analyze must report failure, not just print it. Its prerequisite loop used to
# be a `while read` on a pipe -- a subshell -- so every count was discarded and it
# always exited 0 however broken the machine was.
clean=$(/bin/bash "$VS" analyze --offline 2>&1 || true)
if [ -n "$host_clean" ]; then
    t_rc "analyze exits 0 when all is well" 0 /bin/bash "$VS" analyze --offline
else
    t_skip "analyze exits 0 when all is well" "this host has work outstanding"
fi
t_contains "summary has a prerequisites line" "$clean" "Prerequisites:"
t_contains "summary has a project line"       "$clean" "Project:"
t_contains "a clean machine reads as ready"   "$clean" "ready"

# Outside a project it must say so and exit non-zero.
outside=$(cd / && /bin/bash "$VS" analyze --offline 2>&1 || true)
t_contains "outside a project the marker is reported" "$outside" "project.toml"
case "$outside" in
    *"Project:"*ready*) t_bad "outside a project it still claims ready" ;;
    *)                  t_ok  "outside a project it does not claim ready" ;;
esac
# Must fail outside a project; the exact code also depends on whether this host
# has prerequisite work, so assert only that it is non-zero.
if /bin/bash -c "cd / && '$VS' analyze --offline" >/dev/null 2>&1; then
    t_bad "outside a project it should fail"
else
    t_ok  "outside a project it fails"
fi

# The action column is what makes a no-op obvious. Asserted as the ABSENCE of any
# action, not the presence of a particular no-action token -- the token has now
# been reworded twice, and each time an assertion matching it broke while catching
# nothing.
if [ -n "$host_clean" ]; then
    case "$clean" in
        *"to install"*|*"to upgrade"*|*"needs you"*)
            t_bad "clean run claims work is needed" ;;
        *)
            t_ok  "clean run claims no work" ;;
    esac
else
    t_skip "clean run claims no work" "this host has work outstanding"
fi

# The OS is a gate: when it fails nothing downstream is even reported.
gate=$(mktemp -d)
cp -R "$ROOT/vivario-setup" "$ROOT/vivario-internal" "$gate/"
sed -i '' 's/^MACOS_MIN=.*/MACOS_MIN=99.0/' "$gate/vivario-internal/commands/system"
gated=$(/bin/bash "$gate/vivario-setup" analyze --offline 2>&1 || true)
t_rc "a too-old OS fails" 1 /bin/bash "$gate/vivario-setup" analyze --offline
case "$gated" in
    *prerequisites*) t_bad "OS gate did not stop before prerequisites" ;;
    *)               t_ok  "OS gate stops before prerequisites" ;;
esac
rm -rf "$gate"

# Bare invocation is the main entry point, so it must end by saying vivario is
# ready and how to start it -- not with a second closing line from install.
bare=$(/bin/bash "$VS" --offline 2>&1 || true)
# Deliberately not matching emphasis or punctuation, which get tweaked.
if [ -n "$host_clean" ]; then
    t_contains "bare says vivario is ready" "$bare" "ready to run"
    t_contains "bare says how to start"     "$bare" "vivario-start"
else
    t_skip "bare says vivario is ready" "this host has work outstanding"
fi
case "$bare" in
    *"Nothing to do"*) t_bad "bare ends on a second closing line" ;;
    *)                 t_ok  "bare ends on one closing line" ;;
esac

t_summary
